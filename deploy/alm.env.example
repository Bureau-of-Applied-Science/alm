# ALM settings for the systemd service. install.sh --service creates ~/.config/alm/alm.env from this
# (mode 600, never overwritten). Anything here is optional; with nothing set ALM runs on demo data.

# Watch a server through an ALM collector running on it (deploy/install-collector.sh HOST).
# HOST is an ssh alias with key authentication (see `ssh -o BatchMode=yes HOST true`). Comma separate several.
#ALM_COLLECTOR=myserver

# Extra main.py flags, for sources that need no collector. Examples:
#   watch this machine's journal:        ALM_ARGS=--journal
#   watch a server directly over ssh:    ALM_ARGS=--ssh myserver
#   watch files:                         ALM_ARGS=--tail /var/log/app.log --tail /var/log/other.log
#ALM_ARGS=

# Shared secret for the web page and websocket. Required if you listen beyond localhost
# (ALM_ARGS=--host 0.0.0.0), and the extension's options page needs the same value.
#ALM_TOKEN=change-me

# Where the collector command lives on the server, if you installed it somewhere else.
#ALM_COLLECTOR_CMD=python3 ~/alm-collector/alm_collector.py
