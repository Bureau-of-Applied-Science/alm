# ALM collector on the watched host, as a systemd user service (needs `loginctl enable-linger` there so it
# runs without a login). Do not edit by hand: deploy/install-collector.sh fills in the python path and
# the sources it follows, and installs it to ~/.config/systemd/user/alm-collector.service on the host.
[Unit]
Description=ALM collector (keeps the record for ALM screens)
After=network-online.target

[Service]
ExecStart=@PYTHON@ %h/alm-collector/alm_collector.py run @ARGS@
Restart=always
RestartSec=5
# kill the tail/journalctl children with the service
KillMode=control-group

[Install]
WantedBy=default.target
