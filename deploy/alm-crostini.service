# Chromebook (Crostini) instance: engine here, syncing from a collector on your server, served on localhost:8000
# (Crostini forwards the port to ChromeOS localhost). Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/alm-crostini.service ~/.config/systemd/user/alm.service
#   systemctl --user daemon-reload && systemctl --user enable --now alm
# Stop the hand-started instance first. Needs `loginctl enable-linger` to survive logout.
# Your host and secrets live in ~/.config/alm/alm.env (chmod 600), never in this file:
#   ALM_COLLECTOR=myserver        # ssh alias of the host running alm_collector.py (deploy/install-collector.sh)
#   ALM_TOKEN=...                 # only if you bind beyond loopback
[Unit]
Description=ALM ambient log monitor
After=network-online.target

[Service]
WorkingDirectory=%h/code/alm
EnvironmentFile=-%h/.config/alm/alm.env
ExecStart=%h/code/alm/.venv/bin/python main.py --web-only --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
# ssh children die with the service, even after a hard kill
KillMode=control-group

[Install]
WantedBy=default.target
