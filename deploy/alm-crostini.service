# Chromebook (Crostini) instance: engine here, reading myserver over ssh, served on localhost:8000
# (Crostini forwards the port to ChromeOS localhost). Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/alm-crostini.service ~/.config/systemd/user/alm.service
#   systemctl --user daemon-reload && systemctl --user enable --now alm
# Stop the hand-started instance first. Linger is already on for this user.
[Unit]
Description=ALM ambient log monitor (myserver over ssh)
After=network-online.target

[Service]
WorkingDirectory=%h/code/alm
ExecStart=%h/code/alm/.venv/bin/python main.py --web-only --port 8000 --ssh myserver --ssh-file myserver:/var/log/caddy/access.log:caddy:sudo
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
# ssh children die with the service, even after a hard kill
KillMode=control-group

[Install]
WantedBy=default.target
