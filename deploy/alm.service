# systemd --user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/alm.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now alm
#   loginctl enable-linger $USER     # keep it running when you are logged out
# Edit WorkingDirectory and the log sources below. `--journal` needs membership of the
# systemd-journal (or adm) group to see system logs; without it you only get your user journal.
[Unit]
Description=ALM ambient log monitor
After=network.target

[Service]
WorkingDirectory=%h/alm
EnvironmentFile=-%h/.config/alm.env
ExecStart=%h/alm/.venv/bin/python main.py --web-only --journal
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
