# ALM as a systemd user service. Do not edit by hand: ./install.sh --service renders this with your
# checkout path and installs it to ~/.config/systemd/user/alm.service.
# What it watches comes from ~/.config/alm/alm.env (see deploy/alm.env.example), so no host or secret lives here.
[Unit]
Description=ALM ambient log monitor
After=network-online.target

[Service]
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/alm/alm.env
# $ALM_ARGS is word-split by systemd; main.py also reads ALM_COLLECTOR and ALM_TOKEN itself
ExecStart=@REPO@/.venv/bin/python main.py --web-only --port 8000 $ALM_ARGS
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
# ssh children die with the service, even after a hard kill
KillMode=control-group

[Install]
WantedBy=default.target
